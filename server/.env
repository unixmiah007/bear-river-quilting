PORT=4000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=cms_store
JWT_SECRET=change_this_to_a_long_random_string
ADMIN_PASSWORD=admin

# Gmail SMTP — replace SMTP_USER / SMTP_PASS with your account and an App Password
# (Google Account → Security → 2-Step Verification → App passwords). Not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=replace_with_16_char_app_password
SMTP_FROM="Bear River Quilting" <your.email@gmail.com>
