PORT=4000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=cms_store
JWT_SECRET=change_this_to_a_long_random_string
ADMIN_PASSWORD=admin

# Email (SendGrid): https://sendgrid.com — create an API key with Mail Send permission.
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
# Must be a verified sender or domain in SendGrid (Sender Authentication).
MAIL_FROM_ADDRESS=shaj.k.miah@gmail.com
MAIL_FROM_NAME=Order confirmation
# Optional: staff “New order” from (defaults to MAIL_FROM_ADDRESS)
# MAIL_STAFF_FROM_ADDRESS=
# MAIL_STAFF_FROM_NAME=New order
# Or single-line RFC forms:
MAIL_FROM=Order confirmation <orders@yourdomain.com>

# Comma-separated inboxes that receive "New order …" when checkout completes.
# Also used for long-arm service request notifications (ORDERS_NOTIFY_EMAIL is an alias).
ORDER_NOTIFY_EMAILS=shaj.k.miah@gmail.com,tracyalto@brqllc.com,nadimamin101@gmail.com
# ORDERS_NOTIFY_EMAIL=owner1@example.com,owner2@example.com

# npm run mail:test -w server [-- email@example.com]
# npm run mail:test:notify -w server
#
# Admin → Products → Email blast uses the same SendGrid sender as storefront mail.

# Default ship-from address on printable shipping labels (admin orders)
# SHIP_FROM_NAME=Bear River Quilting
# SHIP_FROM_ADDRESS1=1200 Bear River Road
# SHIP_FROM_ADDRESS2=
# SHIP_FROM_CITY=Logan
# SHIP_FROM_STATE=UT
# SHIP_FROM_POSTAL_CODE=84321
# SHIP_FROM_COUNTRY=United States
# SHIP_FROM_PHONE=1-800-472-7849

# Storefront origin for Stripe return URLs, CORS, and email links.
# Local dev:
CLIENT_ORIGIN=http://localhost:5173
# Production (bearriverquilting.com) — required if NODE_ENV=production and you use a different host:
# CLIENT_ORIGIN=https://bearriverquilting.com
# If unset in production, defaults to https://bearriverquilting.com
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# stripe listen --forward-to localhost:4000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...
