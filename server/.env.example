PORT=4000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=cms_store
JWT_SECRET=change_this_to_a_long_random_string
ADMIN_PASSWORD=admin

# Optional: Gmail SMTP for order confirmation emails (after checkout).
# Create an App Password: https://myaccount.google.com/apppasswords (requires 2-Step Verification).
GMAIL_USER=
# 16-character app password; if Google shows groups with spaces, either remove spaces OR use quotes:
# GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"
GMAIL_APP_PASSWORD=
# Optional "From" header (default: "Order confirmation <GMAIL_USER>")
# MAIL_FROM=
# MAIL_FROM_NAME=

# Comma-separated inboxes that receive "New order …" when checkout completes.
ORDER_NOTIFY_EMAILS=shaj.k.miah@gmail.com,tracyalto@brqllc.com,nadimamin101@gmail.com

# Send a test message: npm run mail:test -w server
# Optional recipient: npm run mail:test -w server -- you@example.com
# To ORDER_NOTIFY_EMAILS list: npm run mail:test:notify -w server
