PORT=4000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=cms_store
JWT_SECRET=change_this_to_a_long_random_string
ADMIN_PASSWORD=admin

# Order notification emails (comma-separated). If unset, defaults to project recipients.
# ORDER_NOTIFY_EMAILS=shaj.k.miah@gmail.com,tracyalto@brqllc.com,nadimamin101@gmail.com

# Mail: if SMTP_HOST, SMTP_USER, and SMTP_PASS are all set, real SMTP is used.
# Otherwise Ethereal (https://ethereal.email) is used — free test inbox; messages are NOT delivered to real Gmail.
# After each order, the server logs an Ethereal "preview" URL you can open in a browser.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Bear River Quilting" <your-address@gmail.com>

# Render / production (optional)
# NODE_ENV=production is usually set by the host.
# CLIENT_ORIGIN is only needed if the browser origin differs from the API (e.g. split static + API).
# SERVE_CLIENT=false disables serving client/dist even in production (API-only mode).
